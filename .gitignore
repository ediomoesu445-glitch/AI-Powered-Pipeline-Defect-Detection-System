data/
models/*.pt
!models/best.pt
# ONNX export is a derived artifact; regenerate with src.export rather than committing it.
models/*.onnx
__pycache__/
.venv/
*.ipynb_checkpoints
wandb/
runs/
.DS_Store
*.log
.gradio/

# deploy/ is its own git repo for the Hugging Face Space. Its git metadata is
# kept out of this repo so the Space's LFS rule for *.pt does not apply to the
# copy of the checkpoint tracked here as a normal blob.
deploy/.gitattributes
deploy/.gitignore
